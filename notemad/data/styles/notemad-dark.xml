<?xml version="1.0" encoding="UTF-8"?>
<style-scheme id="notemad-dark" name="Notemad Dark" version="1.0">
  <author>efferone</author>
  <description>Cool greys with a periwinkle accent.</description>

  <color name="ground"      value="#1F2229"/>
  <color name="gutter"      value="#171A20"/>
  <color name="line"        value="#24282F"/>
  <color name="text"        value="#E8EBF0"/>
  <color name="muted"       value="#838A96"/>
  <color name="selection"   value="#343A46"/>
  <color name="accent"      value="#8AA9F0"/>

  <style name="text"                foreground="text" background="ground"/>
  <style name="selection"           foreground="text" background="selection"/>
  <style name="selection-unfocused" foreground="text" background="line"/>
  <style name="cursor"              foreground="accent"/>
  <style name="current-line"        background="line"/>
  <style name="current-line-number" foreground="accent" background="line" bold="true"/>
  <style name="line-numbers"        foreground="muted" background="gutter"/>
  <style name="right-margin"        foreground="muted" background="muted"/>
  <style name="draw-spaces"         foreground="muted"/>

  <style name="bracket-match"       foreground="accent" background="selection" bold="true"/>
  <style name="bracket-mismatch"    foreground="ground" background="#DDA95F" bold="true"/>
  <style name="search-match"        foreground="ground" background="accent"/>
</style-scheme>
